rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(role) {
      let profile = isSignedIn() ? userData(request.auth.uid) : {};
      return isSignedIn() && (('roles' in profile)
        ? (profile.roles is list && role in profile.roles)
        : profile.get('role', 'member') == role);
    }
    function isAdmin() { return hasRole('admin'); }
    function isSecretariat() { return hasRole('secretariat'); }
    function isFinance() { return hasRole('finance'); }
    function isLeadership() {
      return hasRole('elder') || hasRole('deacon') || hasRole('deaconess') || hasRole('pastor');
    }
    // The pastor reads the church's finances (read-only); only Admin and Finance change them.
    function canViewGiving() { return isAdmin() || isFinance() || hasRole('oversight') || hasRole('pastor'); }
    function validRoles(data) {
      return !('roles' in data) || (data.roles is list && data.roles.size() > 0
        && data.roles.hasOnly(['member', 'deacon', 'deaconess', 'elder', 'pastor', 'finance', 'secretariat', 'hospitality', 'oversight', 'admin']));
    }
    function validGivingLink(data) {
      return !('memberUserId' in data) || (data.memberUserId is string
        && data.memberUserId != ''
        && !('denominationBreakdown' in data) && !('incomeFormId' in data)
        && exists(/databases/$(database)/documents/users/$(data.memberUserId)));
    }
    // Mirrors lib/core/providers/user_role_provider.dart — keep in sync.
    function canManageMembers() { return isAdmin() || isSecretariat() || hasRole('hospitality') || hasRole('pastor'); }
    function canManageGiving() { return isAdmin() || isFinance(); }
    function canManageAttendance() { return isAdmin() || isSecretariat() || isLeadership(); }
    function canManageEvents() { return isAdmin() || isSecretariat() || hasRole('pastor'); }
    function canPostAnnouncements() { return isAdmin() || isSecretariat() || isLeadership(); }
    function canSeeAllPrayer() { return isAdmin() || isSecretariat() || isLeadership(); }

    // A prayer request carries the audience its author chose:
    //   'pastor'         the Pastor only
    //   'pastor_elders'  the Pastor and Elders
    //   'leaders'        every leader (Pastor, Elders, Deacons, Deaconesses, Admin, Secretariat)
    // The author always sees their own. Requests written before this choice existed
    // have no audience and are treated as 'leaders', which is what they were.
    // Mirrors PrayerAudience in lib/models/prayer_request.dart -- keep in sync.
    function canSeePrayer(data) {
      return hasRole('pastor')
        || (hasRole('elder') && data.get('audience', 'leaders') in ['pastor_elders', 'leaders'])
        || (canSeeAllPrayer() && data.get('audience', 'leaders') == 'leaders');
    }
    function validPrayerAudience(a) { return a in ['pastor', 'pastor_elders', 'leaders']; }

    // Self-service profile edits cannot add or change permissions.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || canManageGiving());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && (!('roles' in request.resource.data) || request.resource.data.roles == ['member'])
        // A sign-up may name the role the person holds, for an Admin to approve.
        // It grants nothing by itself, and 'admin' cannot be requested.
        && (!('requestedRole' in request.resource.data)
            || request.resource.data.requestedRole in ['deacon', 'deaconess', 'elder', 'pastor', 'finance', 'secretariat', 'hospitality', 'oversight']);
      allow update: if (isAdmin() && validRoles(request.resource.data)
        && (request.auth.uid != uid || ('admin' in request.resource.data.get('roles', [request.resource.data.get('role', 'member')]))))
        || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'notificationsSeenAt'])
          // 'last opened notifications' is stamped with the server's own clock.
          && (!('notificationsSeenAt' in request.resource.data)
              || request.resource.data.notificationsSeenAt == request.time));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
    // Congregation directory holds personal contact info (email, phone) —
    // readable only by the roles that have a Members tab in the app.
    match /members/{id} {
      allow read, write: if canManageMembers();
    }

    // Financial records — the whole point of this rule set: only Admin and
    // Finance can touch this collection, regardless of any other seniority.
    match /giving/{id} {
      allow read: if canViewGiving() || (isSignedIn() && resource.data.get('memberUserId', '') == request.auth.uid);
      allow create, update: if canManageGiving() && validGivingLink(request.resource.data);
      allow delete: if canManageGiving();
    }

    // Sunday Income Analysis form — same sensitivity as `giving`, since it
    // holds the raw cash counts that giving/attendance records are derived
    // from (Prepared/Checked/Collected By names included).
    match /income_forms/{id} {
      allow read: if canViewGiving();
      allow write: if canManageGiving();
    }

    match /attendance/{id} {
      allow read: if canManageAttendance();
      // Finance can edit or delete only the attendance records a Sunday Income
      // Form created (they carry its incomeFormId), and cannot relink them.
      allow update: if canManageAttendance() || (canManageGiving()
        && resource.data.get('incomeFormId', '') != ''
        && request.resource.data.get('incomeFormId', '') == resource.data.get('incomeFormId', ''));
      allow delete: if canManageAttendance() || (canManageGiving()
        && resource.data.get('incomeFormId', '') != '');
      // A finance officer can save attendance only with a new income form
      // in the same atomic batch, without gaining general attendance access.
      allow create: if canManageAttendance() || (canManageGiving()
        && request.resource.data.get('incomeFormId', '') is string
        && request.resource.data.get('incomeFormId', '') != ''
        && !exists(/databases/$(database)/documents/income_forms/$(request.resource.data.incomeFormId))
        && existsAfter(/databases/$(database)/documents/income_forms/$(request.resource.data.incomeFormId)));
    }

    // Activity log for financial records: written in the same batch as the change
    // it records, readable by those who can see giving, and immutable once written
    // (nobody -- including admins -- can edit or delete an entry).
    match /audit_log/{id} {
      allow read: if canViewGiving();
      allow create: if canManageGiving()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete'];
      allow update, delete: if false;
    }

    // Events are public to every signed-in member; only certain roles edit them.
    match /events/{id} {
      allow read: if isSignedIn();
      allow write: if canManageEvents();
    }

    // 'leaders'-only announcements are hidden from plain members server-side,
    // not just cosmetically as before.
    match /announcements/{id} {
      allow read: if isSignedIn()
                  && (resource.data.targetAudience == 'all' || canPostAnnouncements());
      allow create: if canPostAnnouncements();
      allow update, delete: if canPostAnnouncements();
    }

    // A member always sees their own requests. Everyone else sees only what the
    // author shared with their group (see canSeePrayer above).
    match /prayer_requests/{id} {
      // A new request must say who may see it.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.audience is string
        && validPrayerAudience(request.resource.data.audience);
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || canSeePrayer(resource.data));
      // Someone who may see a request can mark it answered or pending, and delete it,
      // but cannot reword it or widen who sees it. The author may reword it, mark it,
      // change who sees it, and delete it -- but cannot change whose it is or touch
      // anyone else's.
      allow update: if (isSignedIn() && canSeePrayer(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'answered'])
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['request', 'status', 'audience'])
            && request.resource.data.status in ['pending', 'answered']
            && request.resource.data.get('audience', 'leaders') is string
            && validPrayerAudience(request.resource.data.get('audience', 'leaders'))
            && request.resource.data.request is string
            && request.resource.data.request.size() > 0
            && request.resource.data.request.size() <= 2000);
      allow delete: if (isSignedIn() && canSeePrayer(resource.data))
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
